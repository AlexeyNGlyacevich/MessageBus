<Window x:Class="MessageBusExample.Views.AditionalMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageBusExample.Views"
        mc:Ignorable="d"
        Title="AditionalMessageView"
        Height="450" 
        Width="600">
    <Grid>

        <Button x:Name="SendToMainView"
                Height="50"
                Width="auto"
                MinWidth="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Padding="10"
                Content="Отправить сообщение в главное окно"
                Command="{Binding SendMessageToMainViewCommand}">
        </Button>

        <Button x:Name="SendToDialogMessageView"
                Height="50"
                Width="auto"
                MinWidth="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10 70"
                Padding="10"
                Content="Отправить сообщение в родительское окно"
                Command="{Binding SendMessageToMessageViewCommand}">
        </Button>

    </Grid>
</Window>
